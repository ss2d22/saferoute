# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Application
NODE_ENV=production
PORT=8000
APP_NAME=SafeRoute API

# Database
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=saferoute
DATABASE_USERNAME=saferoute
DATABASE_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DATABASE_URL=postgresql://saferoute:CHANGE_THIS_STRONG_PASSWORD@db:5432/saferoute

# JWT - CHANGE THESE IN PRODUCTION
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=30d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@redis:6379/0

# External APIs
ORS_API_KEY=your_openrouteservice_api_key_here
ORS_API_URL=https://api.openrouteservice.org
POLICE_API_BASE_URL=https://data.police.uk/api

# CORS - Update with your frontend domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=5

# Safety Scoring
DEFAULT_LOOKBACK_MONTHS=12
DEFAULT_SAFETY_WEIGHT=0.8
DEFAULT_ROUTE_BUFFER_M=50
MAX_ROUTE_DISTANCE_KM=100

# Grid Configuration (H3 Hexagonal)
GRID_CELL_SIZE_M=73
GRID_TYPE=h3_hexagonal
H3_RESOLUTION=10
SOUTHAMPTON_BBOX=50.85,-1.55,51.0,-1.3

# History Retention
DEFAULT_HISTORY_RETENTION_DAYS=90
MAX_HISTORY_RETENTION_DAYS=365

# Logging
LOG_LEVEL=info

# Admin
ADMIN_API_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING
