# Application
NODE_ENV=development
PORT=8000
APP_NAME=SafeRoute API

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=saferoute
DATABASE_USERNAME=saferoute
DATABASE_PASSWORD=changeme
DATABASE_URL=postgresql://saferoute:changeme@localhost:5432/saferoute

# JWT
JWT_SECRET=changeme-in-production
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# External APIs
ORS_API_KEY=
ORS_API_URL=https://api.openrouteservice.org
POLICE_API_BASE_URL=https://data.police.uk/api

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=5

# Safety Scoring
DEFAULT_LOOKBACK_MONTHS=12
DEFAULT_SAFETY_WEIGHT=0.8
DEFAULT_ROUTE_BUFFER_M=50
MAX_ROUTE_DISTANCE_KM=100

# Grid Configuration (H3 Hexagonal)
GRID_CELL_SIZE_M=73
GRID_TYPE=h3_hexagonal
H3_RESOLUTION=10
SOUTHAMPTON_BBOX=50.85,-1.55,51.0,-1.3

# History Retention
DEFAULT_HISTORY_RETENTION_DAYS=90
MAX_HISTORY_RETENTION_DAYS=365

# Logging
LOG_LEVEL=info

# Admin
ADMIN_API_KEY=
